+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.tasks.tab_management;
+
+import android.graphics.Matrix;
+import android.graphics.Rect;
+import android.graphics.RectF;
+import android.view.View;
+import android.view.ViewParent;
+
+import androidx.core.view.OneShotPreDrawListener;
+
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+
+/** Final-frame geometry shared by tab thumbnails and the page-to-switcher transition. */
+@NullMarked
+final class TabSwitcherAnimationGeometry {
+    private TabSwitcherAnimationGeometry() {}
+
+    static Rect getGlobalBounds(View view) {
+        Matrix matrix = new Matrix();
+        view.transformMatrixToGlobal(matrix);
+        RectF bounds = new RectF(0, 0, view.getWidth(), view.getHeight());
+        matrix.mapRect(bounds);
+        Rect result = new Rect();
+        bounds.round(result);
+        return result;
+    }
+
+    /** Returns a cancellation callback; detaching the view also removes the pre-draw listener. */
+    static Runnable runAfterStableLayout(View view, Runnable onReady) {
+        StableLayoutCallback callback = new StableLayoutCallback(view, onReady);
+        callback.schedule();
+        return callback::cancel;
+    }
+
+    private static boolean hasPendingLayout(View view) {
+        View current = view;
+        while (true) {
+            if (current.isLayoutRequested()) return true;
+            ViewParent parent = current.getParent();
+            if (!(parent instanceof View)) return false;
+            current = (View) parent;
+        }
+    }
+
+    private static final class StableLayoutCallback {
+        private final View mView;
+        private @Nullable Runnable mOnReady;
+        private @Nullable OneShotPreDrawListener mListener;
+
+        StableLayoutCallback(View view, Runnable onReady) {
+            mView = view;
+            mOnReady = onReady;
+        }
+
+        void schedule() {
+            mListener = OneShotPreDrawListener.add(mView, this::onPreDraw);
+            mView.invalidate();
+        }
+
+        private void onPreDraw() {
+            mListener = null;
+            if (mOnReady == null) return;
+            // A parent's onLayout listener can relocate/resize the pane after the RecyclerView
+            // has completed its own layout. Never capture that intermediate card position.
+            if (hasPendingLayout(mView)) {
+                schedule();
+                return;
+            }
+            Runnable onReady = mOnReady;
+            mOnReady = null;
+            onReady.run();
+        }
+
+        void cancel() {
+            mOnReady = null;
+            if (mListener != null) {
+                mListener.removeListener();
+                mListener = null;
+            }
+        }
+    }
+}
