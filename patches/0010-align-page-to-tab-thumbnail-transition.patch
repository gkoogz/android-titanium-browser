+
+package org.chromium.chrome.browser.tasks.tab_management;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertTrue;
+
+import android.app.Activity;
+import android.graphics.Bitmap;
+import android.graphics.Matrix;
+import android.graphics.Rect;
+import android.graphics.drawable.BitmapDrawable;
+import android.util.Size;
+import android.view.View;
+import android.widget.FrameLayout;
+import android.widget.ImageView;
+
+import org.junit.Before;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.robolectric.Robolectric;
+import org.robolectric.annotation.Config;
+import org.robolectric.annotation.LooperMode;
+
+import org.chromium.base.test.BaseRobolectricTestRunner;
+import org.chromium.chrome.browser.hub.ShrinkExpandAnimator;
+import org.chromium.chrome.browser.hub.ShrinkExpandImageView;
+import org.chromium.chrome.browser.tab.TabUtils;
+
+import java.util.ArrayList;
+import java.util.List;
+
+/** Measures the real view hierarchy and final bitmap crop used in the page/card handoff. */
+@RunWith(BaseRobolectricTestRunner.class)
+@Config(sdk = {29, 36})
+@LooperMode(LooperMode.Mode.PAUSED)
+public class TabSwitcherAnimationGeometryUnitTest {
+    private Activity mActivity;
+    private FrameLayout mRoot;
+    private View mDecor;
+
+    @Before
+    public void setUp() {
+        mActivity = Robolectric.buildActivity(Activity.class).setup().get();
+        mRoot = new FrameLayout(mActivity);
+        mActivity.setContentView(mRoot);
+        mDecor = mActivity.getWindow().getDecorView();
+        layout();
+    }
+
+    private void layout() {
+        mDecor.measure(
+                View.MeasureSpec.makeMeasureSpec(1000, View.MeasureSpec.EXACTLY),
+                View.MeasureSpec.makeMeasureSpec(2000, View.MeasureSpec.EXACTLY));
+        mDecor.layout(0, 0, 1000, 2000);
+    }
+
+    private View addThumbnail(FrameLayout parent, int width, int height, int left, int top) {
+        View thumbnail = new View(mActivity);
+        FrameLayout.LayoutParams params = new FrameLayout.LayoutParams(width, height);
+        params.leftMargin = left;
+        params.topMargin = top;
+        parent.addView(thumbnail, params);
+        layout();
+        return thumbnail;
+    }
+
+    @Test
+    public void boundsPreserveTheUnclippedThumbnail() {
+        FrameLayout pane = new FrameLayout(mActivity);
+        mRoot.addView(pane, new FrameLayout.LayoutParams(400, 200));
+        View thumbnail = addThumbnail(pane, 300, 500, 20, 120);
+        Rect visible = new Rect();
+        thumbnail.getGlobalVisibleRect(visible);
+        Rect bounds = TabSwitcherAnimationGeometry.getGlobalBounds(thumbnail);
+        assertEquals(300, bounds.width());
+        assertEquals(500, bounds.height());
+        assertTrue(visible.height() < bounds.height());
+        int[] location = new int[2];
+        thumbnail.getLocationOnScreen(location);
+        assertEquals(location[0], bounds.left);
+        assertEquals(location[1], bounds.top);
+    }
+
+    @Test
+    public void boundsIncludeAncestorScaleAndTranslation() {
+        FrameLayout card = new FrameLayout(mActivity);
+        mRoot.addView(card, new FrameLayout.LayoutParams(500, 700));
+        View thumbnail = addThumbnail(card, 200, 400, 20, 30);
+        card.setPivotX(0);
+        card.setPivotY(0);
+        card.setScaleX(0.75f);
+        card.setScaleY(0.5f);
+        card.setTranslationX(40);
+        card.setTranslationY(60);
+        int[] parentLocation = new int[2];
+        card.getLocationOnScreen(parentLocation);
+        Rect bounds = TabSwitcherAnimationGeometry.getGlobalBounds(thumbnail);
+        assertEquals(
+                new Rect(
+                        parentLocation[0] + 15,
+                        parentLocation[1] + 15,
+                        parentLocation[0] + 165,
+                        parentLocation[1] + 215),
+                bounds);
+    }
+
+    @Test
+    public void layoutCompletionDoesNotSupplyGeometryBeforePreDraw() {
+        View thumbnail = addThumbnail(mRoot, 300, 500, 20, 240);
+        List<Rect> supplied = new ArrayList<>();
+        TabSwitcherAnimationGeometry.runAfterStableLayout(
+                thumbnail,
+                () -> supplied.add(TabSwitcherAnimationGeometry.getGlobalBounds(thumbnail)));
+        layout();
+        assertEquals(0, supplied.size());
+        thumbnail.getViewTreeObserver().dispatchOnPreDraw();
+        assertEquals(1, supplied.size());
+        thumbnail.getViewTreeObserver().dispatchOnPreDraw();
+        assertEquals(1, supplied.size());
+    }
+
+    @Test
+    public void parentRelayoutAfterChildLayoutSuppliesOnlyFinalBounds() {
+        View thumbnail = addThumbnail(mRoot, 300, 500, 20, 240);
+        List<Rect> supplied = new ArrayList<>();
+        TabSwitcherAnimationGeometry.runAfterStableLayout(
+                thumbnail,
+                () -> supplied.add(TabSwitcherAnimationGeometry.getGlobalBounds(thumbnail)));
+        Rect intermediate = TabSwitcherAnimationGeometry.getGlobalBounds(thumbnail);
+        // Reproduce the bottom toolbar's onLayout listener changing the pane's margins
+        // after the thumbnail's own onLayoutCompleted has already fired.
+        FrameLayout.LayoutParams params = (FrameLayout.LayoutParams) thumbnail.getLayoutParams();
+        params.topMargin = 0;
+        thumbnail.setLayoutParams(params);
+        thumbnail.getViewTreeObserver().dispatchOnPreDraw();
+        assertEquals(0, supplied.size());
+        layout();
+        thumbnail.getViewTreeObserver().dispatchOnPreDraw();
+        assertEquals(1, supplied.size());
+        assertEquals(intermediate.top - 240, supplied.get(0).top);
+    }
+
+    @Test
+    public void cancellationAndDetachDoNotRunTheGeometryCallback() {
+        View thumbnail = addThumbnail(mRoot, 300, 500, 0, 0);
+        int[] count = {0};
+        Runnable cancel =
+                TabSwitcherAnimationGeometry.runAfterStableLayout(thumbnail, () -> count[0]++);
+        cancel.run();
+        thumbnail.getViewTreeObserver().dispatchOnPreDraw();
+        assertEquals(0, count[0]);
+        TabSwitcherAnimationGeometry.runAfterStableLayout(thumbnail, () -> count[0]++);
+        mRoot.removeView(thumbnail);
+        mRoot.getViewTreeObserver().dispatchOnPreDraw();
+        assertEquals(0, count[0]);
+    }
+
+    private ShrinkExpandImageView image(Rect initial, Bitmap bitmap) {
+        ShrinkExpandImageView image = new ShrinkExpandImageView(mActivity);
+        mRoot.addView(image, new FrameLayout.LayoutParams(initial.width(), initial.height()));
+        image.resetKeepingBitmap(initial);
+        image.setImageBitmap(bitmap);
+        layout();
+        return image;
+    }
+
+    private void assertCropMatchesCard(Rect initial, Rect target, boolean compareInitial) {
+        Bitmap bitmap = Bitmap.createBitmap(1000, 500, Bitmap.Config.ARGB_8888);
+        bitmap.setDensity(Bitmap.DENSITY_NONE);
+        ShrinkExpandImageView image = image(initial, bitmap);
+        ShrinkExpandAnimator animator = new ShrinkExpandAnimator(image, initial, target, 0);
+        Rect card = compareInitial ? initial : target;
+        animator.setRect(card);
+        ImageView thumbnail = new ImageView(mActivity);
+        TabUtils.setDrawableAndUpdateImageMatrix(
+                thumbnail,
+                new BitmapDrawable(mActivity.getResources(), bitmap),
+                new Size(card.width(), card.height()));
+        thumbnail.layout(0, 0, card.width(), card.height());
+        Matrix mapping = new Matrix(image.getMatrix());
+        mapping.preConcat(image.getImageMatrix());
+        float[] actual = {0, 0, 1000, 500};
+        float[] expected = actual.clone();
+        mapping.mapPoints(actual);
+        thumbnail.getImageMatrix().mapPoints(expected);
+        for (int i = 0; i < actual.length; i += 2) {
+            assertEquals(expected[i], actual[i] + image.getLeft() - card.left, 0.51f);
+            assertEquals(expected[i + 1], actual[i + 1] + image.getTop() - card.top, 0.51f);
+        }
+    }
+
+    @Test
+    public void shrinkEndsWithExactlyTheCardsTallCrop() {
+        assertCropMatchesCard(new Rect(0, 0, 1000, 500), new Rect(700, 600, 900, 1000), false);
+    }
+
+    @Test
+    public void expandStartsWithExactlyTheCardsTallCrop() {
+        assertCropMatchesCard(new Rect(700, 600, 900, 1000), new Rect(0, 0, 1000, 500), true);
+    }
+
+    @Test
+    public void bitmapScaleChangesContinuouslyAcrossTheMorph() {
+        Rect initial = new Rect(0, 0, 1000, 500);
+        Rect target = new Rect(700, 600, 900, 1000);
+        Bitmap bitmap = Bitmap.createBitmap(1000, 500, Bitmap.Config.ARGB_8888);
+        ShrinkExpandImageView image = image(initial, bitmap);
+        ShrinkExpandAnimator animator = new ShrinkExpandAnimator(image, initial, target, 0);
+        float previous = 1;
+        for (int step = 0; step <= 100; step++) {
+            float fraction = step / 100f;
+            Rect current =
+                    new Rect(
+                            Math.round(700 * fraction),
+                            Math.round(600 * fraction),
+                            Math.round(1000 - 100 * fraction),
+                            Math.round(500 + 500 * fraction));
+            animator.setRect(current);
+            float[] values = new float[9];
+            image.getImageMatrix().getValues(values);
+            float scale = values[Matrix.MSCALE_X] * image.getScaleX();
+            assertTrue(Float.isFinite(scale));
+            assertEquals(1 - 0.2f * fraction, scale, 0.001f);
+            assertTrue(Math.abs(scale - previous) < 0.003f);
+            previous = scale;
+        }
+    }
+}
