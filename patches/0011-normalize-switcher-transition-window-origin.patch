+    @Test
+    public void transitionPreparationRestoresFanPropertiesAfterBinding() {
+        horizontalCards(true, true);
+        layout(5, 1000);
+        View primary = mManager.findViewByPosition(4);
+        View next = mManager.findViewByPosition(3);
+        next.setScaleY(1);
+        next.setPivotY(0);
+        next.setTranslationX(0);
+        mManager.prepareForTransition();
+        assertEquals(0.975f, next.getScaleY(), 0.001f);
+        assertEquals(700f, next.getPivotY(), 0.001f);
+        assertTrue(next.getX() < primary.getX());
+        assertTrue(next.getX() > primary.getX() - 40);
+        assertEquals(
+                primary.getTop() + 17.5f,
+                next.getTop() + next.getPivotY() * (1 - next.getScaleY()),
+                0.001f);
+    }
 }
