+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.tasks.tab_management;
+
+import android.content.Context;
+import android.graphics.Rect;
+import android.view.View;
+
+import androidx.recyclerview.widget.GridLayoutManager;
+import androidx.recyclerview.widget.RecyclerView;
+
+import org.chromium.build.annotations.NullMarked;
+
+import java.util.function.IntPredicate;
+
+/** Retains tab-grid behavior while optionally displaying wide, overlapping preview cards. */
+@NullMarked
+class TabCardLayoutManager extends GridLayoutManager {
+    private final int mMinimumStride;
+    private boolean mStacked;
+    private boolean mBottomAnchored;
+    private int mCardHeight;
+
+    TabCardLayoutManager(Context context, int spanCount) {
+        super(context, spanCount);
+        mMinimumStride = Math.round(112 * context.getResources().getDisplayMetrics().density);
+    }
+
+    boolean setPresentation(boolean stacked, boolean bottomAnchored) {
+        if (mStacked == stacked && mBottomAnchored == bottomAnchored) return false;
+        mStacked = stacked;
+        mBottomAnchored = bottomAnchored;
+        requestLayout();
+        return true;
+    }
+
+    boolean setCardHeight(int height) {
+        if (mCardHeight == height) return false;
+        mCardHeight = height;
+        return true;
+    }
+
+    RecyclerView.ItemDecoration getOverlapDecoration(IntPredicate isTabCard) {
+        return new RecyclerView.ItemDecoration() {
+            @Override
+            public void getItemOffsets(
+                    Rect outRect, View view, RecyclerView parent, RecyclerView.State state) {
+                outRect.setEmpty();
+                int position = parent.getChildAdapterPosition(view);
+                if (!mStacked || position <= 0
+                        || state.isPreLayout() || position >= state.getItemCount()
+                        || !isTabCard.test(position) || !isTabCard.test(position - 1)) {
+                    return;
+                }
+                // Keep the title, close button and a useful portion of the preview exposed.
+                // Overlap the previous card from this card's top. In particular, the final
+                // preview never has a cached negative bottom inset after the last tab closes.
+                // Message cards keep their full height.
+                int stride = Math.max(mMinimumStride, Math.round(mCardHeight * 0.38f));
+                outRect.top = -Math.max(0, mCardHeight - stride);
+            }
+        };
+    }
+
+    @Override
+    public boolean supportsPredictiveItemAnimations() {
+        return !mStacked && super.supportsPredictiveItemAnimations();
+    }
+
+    @Override
+    public void onLayoutChildren(RecyclerView.Recycler recycler, RecyclerView.State state) {
+        super.onLayoutChildren(recycler, state);
+        if (!state.isPreLayout()) alignShortListToBottom(state);
+    }
+
+    @Override
+    public int scrollVerticallyBy(
+            int dy, RecyclerView.Recycler recycler, RecyclerView.State state) {
+        int consumed = super.scrollVerticallyBy(dy, recycler, state);
+        return alignShortListToBottom(state) ? 0 : consumed;
+    }
+
+    private boolean alignShortListToBottom(RecyclerView.State state) {
+        if (!mBottomAnchored || getChildCount() == 0
+                || findFirstVisibleItemPosition() != 0
+                || findLastVisibleItemPosition() != state.getItemCount() - 1) {
+            return false;
+        }
+        int firstTop = Integer.MAX_VALUE;
+        int lastBottom = Integer.MIN_VALUE;
+        for (int i = 0; i < getChildCount(); ++i) {
+            View child = getChildAt(i);
+            if (child == null) continue;
+            firstTop = Math.min(firstTop, getDecoratedTop(child));
+            lastBottom = Math.max(lastBottom, getDecoratedBottom(child));
+        }
+        int available = getHeight() - getPaddingTop() - getPaddingBottom();
+        if (lastBottom - firstTop > available) return false;
+        offsetChildrenVertical(getHeight() - getPaddingBottom() - lastBottom);
+        return true;
+    }
+}
