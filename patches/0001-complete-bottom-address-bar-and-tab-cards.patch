+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.tasks.tab_management;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertTrue;
+
+import android.app.Activity;
+import android.view.View;
+import android.view.ViewGroup;
+import android.widget.TextView;
+
+import androidx.recyclerview.widget.RecyclerView;
+
+import org.junit.Before;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.robolectric.Robolectric;
+import org.robolectric.annotation.Config;
+
+import org.chromium.base.test.BaseRobolectricTestRunner;
+
+/** Real RecyclerView measurements and scrolling, using the production layout manager. */
+@RunWith(BaseRobolectricTestRunner.class)
+@Config(manifest = Config.NONE, sdk = 28)
+public class TabCardLayoutManagerUnitTest {
+    private Activity mActivity;
+    private RecyclerView mView;
+    private TabCardLayoutManager mManager;
+    private int mCount;
+
+    @Before
+    public void setUp() {
+        mActivity = Robolectric.buildActivity(Activity.class).setup().get();
+        mView = new RecyclerView(mActivity);
+        mManager = new TabCardLayoutManager(mActivity, 1);
+        mManager.setCardHeight(400);
+        mView.setLayoutManager(mManager);
+        mView.setItemAnimator(null);
+        mView.addItemDecoration(mManager.getOverlapDecoration(position -> true));
+        mView.setAdapter(new RecyclerView.Adapter<RecyclerView.ViewHolder>() {
+            @Override
+            public RecyclerView.ViewHolder onCreateViewHolder(ViewGroup parent, int type) {
+                TextView view = new TextView(mActivity);
+                view.setLayoutParams(new RecyclerView.LayoutParams(
+                        ViewGroup.LayoutParams.MATCH_PARENT, 400));
+                return new RecyclerView.ViewHolder(view) {};
+            }
+
+            @Override
+            public void onBindViewHolder(RecyclerView.ViewHolder holder, int position) {
+                ((TextView) holder.itemView).setText("Tab " + position);
+            }
+
+            @Override
+            public int getItemCount() {
+                return mCount;
+            }
+        });
+        mActivity.setContentView(mView);
+    }
+
+    private void layout(int count, int height) {
+        mCount = count;
+        mView.getAdapter().notifyDataSetChanged();
+        mView.measure(View.MeasureSpec.makeMeasureSpec(360, View.MeasureSpec.EXACTLY),
+                View.MeasureSpec.makeMeasureSpec(height, View.MeasureSpec.EXACTLY));
+        mView.layout(0, 0, 360, height);
+    }
+
+    @Test
+    public void shortCardsOverlapAndEndAtBottom() {
+        mManager.setPresentation(true, true);
+        layout(3, 1000);
+        View first = mManager.findViewByPosition(0);
+        View second = mManager.findViewByPosition(1);
+        View last = mManager.findViewByPosition(2);
+        assertTrue(first.getTop() > 0);
+        assertTrue(second.getTop() < first.getBottom());
+        assertTrue(second.getTop() - first.getTop() >= 112);
+        assertEquals(1000, last.getBottom());
+        assertEquals(400, last.getHeight());
+        assertFalse(mManager.supportsPredictiveItemAnimations());
+    }
+
+    @Test
+    public void oneCardAndEmptyList() {
+        mManager.setPresentation(true, true);
+        layout(0, 1000);
+        assertEquals(0, mView.getChildCount());
+        layout(1, 1000);
+        assertEquals(600, mManager.findViewByPosition(0).getTop());
+        assertEquals(1000, mManager.findViewByPosition(0).getBottom());
+    }
+
+    @Test
+    public void gridKeepsColumnsAndBottomAlignment() {
+        mManager.setSpanCount(2);
+        mManager.setPresentation(false, true);
+        layout(3, 1000);
+        View first = mManager.findViewByPosition(0);
+        View second = mManager.findViewByPosition(1);
+        assertEquals(first.getTop(), second.getTop());
+        assertEquals(180, second.getLeft());
+        assertEquals(1000, mManager.findViewByPosition(2).getBottom());
+    }
+
+    @Test
+    public void longStackCanScrollToBothEnds() {
+        mManager.setPresentation(true, true);
+        layout(50, 1000);
+        mView.scrollBy(0, 600);
+        assertTrue(mManager.findFirstVisibleItemPosition() > 0);
+        mView.scrollToPosition(49);
+        layout(50, 1000);
+        assertTrue(mManager.findLastVisibleItemPosition() >= 49);
+        mView.scrollToPosition(0);
+        layout(50, 1000);
+        assertEquals(0, mManager.findFirstVisibleItemPosition());
+    }
+
+    @Test
+    public void layoutCanReturnToTopGrid() {
+        mManager.setPresentation(true, true);
+        layout(2, 1000);
+        mManager.setPresentation(false, false);
+        mManager.setSpanCount(2);
+        mView.invalidateItemDecorations();
+        layout(2, 1000);
+        assertEquals(0, mManager.findViewByPosition(0).getTop());
+        assertEquals(0, mManager.findViewByPosition(1).getTop());
+    }
+
+    @Test
+    public void closingCardReflowsStackAndKeepsLastCardReachable() {
+        mManager.setPresentation(true, true);
+        layout(3, 1000);
+        mCount = 2;
+        mView.getAdapter().notifyItemRemoved(1);
+        mView.requestLayout();
+        mView.measure(View.MeasureSpec.makeMeasureSpec(360, View.MeasureSpec.EXACTLY),
+                View.MeasureSpec.makeMeasureSpec(1000, View.MeasureSpec.EXACTLY));
+        mView.layout(0, 0, 360, 1000);
+        assertEquals(1000, mManager.findViewByPosition(1).getBottom());
+    }
+
+    @Test
+    public void messageCardsDoNotOverlapAndBottomPaddingIsReserved() {
+        mView.removeItemDecorationAt(0);
+        mView.addItemDecoration(mManager.getOverlapDecoration(position -> position != 1));
+        mManager.setPresentation(true, true);
+        mView.setPadding(0, 0, 0, 30);
+        layout(3, 1400);
+        View first = mManager.findViewByPosition(0);
+        View message = mManager.findViewByPosition(1);
+        View last = mManager.findViewByPosition(2);
+        assertEquals(first.getBottom(), message.getTop());
+        assertEquals(message.getBottom(), last.getTop());
+        assertEquals(1370, last.getBottom());
+    }
+
+    @Test
+    public void shorterWindowRemainsScrollable() {
+        mManager.setPresentation(true, true);
+        layout(3, 450);
+        mView.scrollToPosition(2);
+        layout(3, 450);
+        assertEquals(2, mManager.findLastVisibleItemPosition());
+        assertTrue(mView.canScrollVertically(-1));
+    }
+
+    @Test
+    public void closingLastCardExposesFullPreviousPreview() {
+        mManager.setPresentation(true, true);
+        layout(3, 1000);
+        mCount = 2;
+        mView.getAdapter().notifyItemRemoved(2);
+        mView.requestLayout();
+        mView.measure(View.MeasureSpec.makeMeasureSpec(360, View.MeasureSpec.EXACTLY),
+                View.MeasureSpec.makeMeasureSpec(1000, View.MeasureSpec.EXACTLY));
+        mView.layout(0, 0, 360, 1000);
+        assertEquals(1000, mManager.findViewByPosition(1).getBottom());
+    }
+
+    @Test
+    public void closingFirstCardKeepsNewFirstCardVisible() {
+        mManager.setPresentation(true, true);
+        layout(3, 1000);
+        mCount = 2;
+        mView.getAdapter().notifyItemRemoved(0);
+        mView.requestLayout();
+        mView.measure(View.MeasureSpec.makeMeasureSpec(360, View.MeasureSpec.EXACTLY),
+                View.MeasureSpec.makeMeasureSpec(1000, View.MeasureSpec.EXACTLY));
+        mView.layout(0, 0, 360, 1000);
+        assertTrue(mManager.findViewByPosition(0).getTop() >= 0);
+        assertEquals(1000, mManager.findViewByPosition(1).getBottom());
+    }
+}
