+TEST_F(JpegThumbnailHelperTest, PreserveFineDetail) {
+  // Alternating two-pixel bars disappear when the preview is halved before encoding.
+  SkBitmap image;
+  ASSERT_TRUE(image.tryAllocN32Pixels(120, 80));
+  for (int y = 0; y < image.height(); ++y) {
+    for (int x = 0; x < image.width(); ++x) {
+      *image.getAddr32(x, y) = (x / 2) % 2 ? SK_ColorWHITE : SK_ColorBLACK;
