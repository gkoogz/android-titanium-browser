+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.ntp;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertTrue;
+
+import android.app.Activity;
+import android.view.Gravity;
+import android.view.View;
+import android.view.ViewGroup;
+import android.widget.LinearLayout;
+import android.widget.ScrollView;
+
+import org.junit.Before;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.robolectric.Robolectric;
+import org.robolectric.annotation.Config;
+
+import org.chromium.base.test.BaseRobolectricTestRunner;
+import org.chromium.chrome.R;
+
+/** Measures home-page ordering against a real, resizable scroll viewport. */
+@RunWith(BaseRobolectricTestRunner.class)
+@Config(manifest = Config.NONE, sdk = {29, 36}, qualifiers = "sw360dp")
+public class BottomNewTabPageLayoutUnitTest {
+    private NewTabPageLayout mLayout;
+    private ScrollView mViewport;
+    private View mLogo;
+    private View mSearch;
+    private View mTiles;
+    private View mModule;
+    private int mToolbarHeight;
+
+    private View addChild(Activity activity, int height) {
+        View view = new View(activity);
+        mLayout.addView(view, new LinearLayout.LayoutParams(360, height));
+        return view;
+    }
+
+    @Before
+    public void setUp() {
+        Activity activity = Robolectric.buildActivity(Activity.class).setup().get();
+        mViewport = new ScrollView(activity);
+        mLayout = new NewTabPageLayout(activity, null);
+        mLayout.setOrientation(LinearLayout.VERTICAL);
+        mLayout.setGravity(Gravity.CENTER);
+        mToolbarHeight = activity.getResources().getDimensionPixelSize(
+                R.dimen.toolbar_height_no_shadow);
+        mLayout.setTopInset(mToolbarHeight);
+        mLogo = addChild(activity, 80);
+        mSearch = addChild(activity, 70);
+        mTiles = addChild(activity, 200);
+        mModule = addChild(activity, 120);
+        View spacer = addChild(activity, 0);
+        spacer.setId(R.id.no_search_logo_spacer);
+        ((LinearLayout.LayoutParams) spacer.getLayoutParams()).weight = 1;
+        mLayout.setSearchBoxView(mSearch);
+        mViewport.addView(mLayout, new ScrollView.LayoutParams(
+                ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT));
+        activity.setContentView(mViewport);
+    }
+
+    private void layout(int height) {
+        // A second pass applies the viewport size observed during the first layout.
+        for (int i = 0; i < 3; ++i) {
+            mLayout.requestLayout();
+            mViewport.measure(View.MeasureSpec.makeMeasureSpec(360, View.MeasureSpec.EXACTLY),
+                    View.MeasureSpec.makeMeasureSpec(height, View.MeasureSpec.EXACTLY));
+            mViewport.layout(0, 0, 360, height);
+        }
+    }
+
+    @Test
+    public void bottomSearchSitsBelowBottomAlignedContents() {
+        mLayout.setBottomAnchored(true);
+        layout(1000);
+        assertEquals(1000, mSearch.getBottom());
+        assertEquals(mSearch.getTop(), mModule.getBottom());
+        assertEquals(mModule.getTop(), mTiles.getBottom());
+        assertEquals(mTiles.getTop(), mLogo.getBottom());
+        assertTrue(mLogo.getTop() > 0);
+    }
+
+    @Test
+    public void returningToTopRestoresOrderInsetsAndWrapContent() {
+        mLayout.setBottomAnchored(true);
+        layout(1000);
+        mLayout.setBottomAnchored(false);
+        layout(1000);
+        assertEquals(1, mLayout.indexOfChild(mSearch));
+        assertEquals(Gravity.CENTER, mLayout.getGravity());
+        assertEquals(mToolbarHeight, mLayout.getPaddingTop());
+        assertEquals(0, mLayout.getMinimumHeight());
+        assertTrue(mLayout.getHeight() < 1000);
+    }
+
+    @Test
+    public void keepsStatusBarAndBottomPadding() {
+        mLayout.setPadding(0, mToolbarHeight, 0, 13);
+        mLayout.setTopInset(mToolbarHeight + 24);
+        mLayout.setBottomAnchored(true);
+        layout(1000);
+        assertEquals(24, mLayout.getPaddingTop());
+        assertEquals(987, mSearch.getBottom());
+    }
+
+    @Test
+    public void followsSmallerViewportAboveKeyboardOrInLandscape() {
+        mLayout.setBottomAnchored(true);
+        layout(1000);
+        layout(600);
+        assertEquals(600, mSearch.getBottom());
+        assertEquals(600, mLayout.getHeight());
+    }
+
+    @Test
+    public void overflowingContentsRemainScrollable() {
+        mLayout.addView(new View(mLayout.getContext()),
+                new LinearLayout.LayoutParams(360, 1300));
+        mLayout.setBottomAnchored(true);
+        layout(1000);
+        assertTrue(mLayout.getHeight() > 1000);
+        assertTrue(mViewport.canScrollVertically(1));
+        assertEquals(mLayout.getHeight(), mSearch.getBottom());
+    }
+
+    @Test
+    public void noLogoSpacerDoesNotSeparateContentFromSearch() {
+        mLogo.setVisibility(View.GONE);
+        mLayout.setBottomAnchored(true);
+        layout(1000);
+        assertEquals(mSearch.getTop(), mModule.getBottom());
+        assertTrue(mTiles.getTop() > 500);
+    }
+
+    @Test
+    public void focusingBottomSearchDoesNotTranslateHomeToTheTop() {
+        mLayout.setBottomAnchored(true);
+        layout(1000);
+        mLayout.setTranslationYOfFakeboxAndAbove(-500f);
+        assertEquals(0f, mSearch.getTranslationY(), 0f);
+        assertEquals(0f, mTiles.getTranslationY(), 0f);
+        assertEquals(1000, mSearch.getBottom());
+    }
+
+    @Test
+    public void topFocusTranslationRetainsExistingBehavior() {
+        layout(1000);
+        mLayout.setTranslationYOfFakeboxAndAbove(-50f);
+        assertEquals(-50f, mLogo.getTranslationY(), 0f);
+        assertEquals(-50f, mSearch.getTranslationY(), 0f);
+        assertEquals(0f, mTiles.getTranslationY(), 0f);
+    }
+
+    @Test
+    public void lateAddedModuleStaysAboveSearch() {
+        mLayout.setBottomAnchored(true);
+        layout(1000);
+        View late = new View(mLayout.getContext());
+        mLayout.addView(late, new LinearLayout.LayoutParams(360, 30));
+        layout(1000);
+        assertEquals(mLayout.getChildCount() - 1, mLayout.indexOfChild(mSearch));
+        assertEquals(mSearch.getTop(), late.getBottom());
+        assertEquals(1000, mSearch.getBottom());
+    }
+}
