+                com.google.android.material.R.style.Theme_Material3_Dark_NoActionBar);
+    }
+
+    private void applyOverlay(Context context) {
+        context.getTheme().applyStyle(R.style.ThemeOverlay_BrowserUI_OledBlack, true);
+    }
+
+    private int color(Context context, int attribute) {
+        return MaterialColors.getColor(context, attribute, "OledBlackThemeTest");
+    }
+
+    @Test
+    public void overlayIsOptIn() {
+        Context context = createContext();
+        assertFalse(OledBlackTheme.isEnabled(context));
+        applyOverlay(context);
+        assertTrue(OledBlackTheme.isEnabled(context));
+        assertFalse(OledBlackTheme.isEnabled(createContext()));
+    }
+
+    @Test
+    public void surfacesAreOpaquePureBlack() {
+        Context context = createContext();
+        applyOverlay(context);
+        for (int attr : new int[] {android.R.attr.colorBackground, R.attr.colorSurface,
+                R.attr.colorSurfaceVariant, R.attr.colorSurfaceDim, R.attr.colorSurfaceBright,
+                R.attr.colorSurfaceContainerLowest, R.attr.colorSurfaceContainerLow,
+                R.attr.colorSurfaceContainer, R.attr.colorSurfaceContainerHigh,
+                R.attr.colorSurfaceContainerHighest}) {
+            assertEquals(Color.BLACK, color(context, attr));
+        }
+    }
+
+    @Test
+    public void accentPaletteAndItsTextColorsArePreserved() {
+        Context context = createContext();
+        int[] accents = {R.attr.colorPrimary, R.attr.colorOnPrimary, R.attr.colorPrimaryContainer,
+                R.attr.colorOnPrimaryContainer, R.attr.colorSecondary, R.attr.colorOnSecondary,
+                R.attr.colorSecondaryContainer, R.attr.colorOnSecondaryContainer,
+                R.attr.colorTertiary, R.attr.colorOnTertiary};
+        int[] before = new int[accents.length];
+        for (int i = 0; i < accents.length; ++i) before[i] = color(context, accents[i]);
+        applyOverlay(context);
+        for (int i = 0; i < accents.length; ++i) {
+            assertEquals(before[i], color(context, accents[i]));
+        }
+    }
+
+    @Test
+    public void elevationCannotRetintBlackSurfaces() {
+        Context context = createContext();
+        applyOverlay(context);
+        TypedValue value = new TypedValue();
+        assertTrue(context.getTheme().resolveAttribute(R.attr.elevationOverlayEnabled, value, true));
+        assertEquals(0, value.data);
+        assertEquals(Color.BLACK, color(context, R.attr.elevationOverlayColor));
+    }
+
+    @Test
+    public void textRemainsReadableOnBlack() {
+        Context context = createContext();
+        applyOverlay(context);
+        assertTrue(ColorUtils.calculateContrast(color(context, R.attr.colorOnSurface), Color.BLACK)
+                >= 4.5);
+    }
